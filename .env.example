# ==========================================
# Cash Mod — Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Discord Bot Credentials (REQUIRED)
# ------------------------------------------
# Replace with your bot token from the Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: Application Client ID
DISCORD_CLIENT_ID=your_client_id_here

# Runtime Environment: development | production | test
NODE_ENV=development

# ------------------------------------------
# 2. Server / Guild Configuration
# ------------------------------------------
# The single Discord Guild (Server) ID to operate on (17-20 digit snowflake)
DISCORD_GUILD_ID=123456789012345678

# ------------------------------------------
# 3. JTC Anchor Category (REQUIRED)
# ------------------------------------------
# The existing Discord category snowflake ID in your guild.
# All 8 JTC categories (Solo -> Octa) are created dynamically immediately below this anchor.
JTC_ANCHOR_CATEGORY_ID=123456789012345679

# ------------------------------------------
# 4. JTC Trigger Voice Channel IDs (17-20 digit snowflakes)
# ------------------------------------------
# Voice channels that members join to trigger creation of a new room
JTC_TRIGGER_SOLO_ID=100000000000000001
JTC_TRIGGER_DUO_ID=100000000000000002
JTC_TRIGGER_TRIO_ID=100000000000000003
JTC_TRIGGER_QUAD_ID=100000000000000004
JTC_TRIGGER_PENTA_ID=100000000000000005
JTC_TRIGGER_HEPTA_ID=100000000000000006
JTC_TRIGGER_SEPTA_ID=100000000000000007
JTC_TRIGGER_OCTA_ID=100000000000000008

# ------------------------------------------
# 5. Private JTC Configuration (17-20 digit snowflakes)
# ------------------------------------------
# Existing Discord anchor category snowflake ID for Private Rooms (dynamic category created below this anchor)
JTC_PRIVATE_ANCHOR_CATEGORY_ID=123456789012345680
# Trigger voice channel snowflake ID members join to auto-create a private room
JTC_PRIVATE_TRIGGER_ID=100000000000000009

# ------------------------------------------
# 6. Logging & Diagnostics
# ------------------------------------------
# Log Level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Debug mode: true | false
DEBUG_MODE=false

# ------------------------------------------
# 7. Bot Presence & Activity
# ------------------------------------------
# Activity name and type: Listening | Playing | Streaming | Watching | Competing | Custom
BOT_ACTIVITY_NAME="CA Study Hub"
BOT_ACTIVITY_TYPE=Listening

# ------------------------------------------
# 8. Restricted Moderation Role IDs (Optional)
# ------------------------------------------
# Discord snowflake IDs for moderation roles denied access to JTC channels
ROLE_QUARANTINE_ID=
ROLE_SUPER_FOCUS_ID=
ROLE_VC_RESTRICTED_ID=


