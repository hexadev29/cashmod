# ==========================================
# Cash Mod — Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Discord Bot Credentials (REQUIRED)
# ------------------------------------------
# Replace with your bot token from the Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: Application Client ID
DISCORD_CLIENT_ID=your_client_id_here

# Runtime Environment: development | production | test
NODE_ENV=development

# ------------------------------------------
# 2. Server / Guild Configuration
# ------------------------------------------
# The single Discord Guild (Server) ID to operate on (17-20 digit snowflake)
DISCORD_GUILD_ID=123456789012345678

# ------------------------------------------
# 3. JTC Category IDs (17-20 digit snowflakes)
# ------------------------------------------
# Category ordering: Solo -> Duo -> Trio -> Quad -> Penta -> Hexa -> Septa -> Octa
JTC_CATEGORY_SOLO_ID=111111111111111111
JTC_CATEGORY_DUO_ID=222222222222222222
JTC_CATEGORY_TRIO_ID=333333333333333333
JTC_CATEGORY_QUAD_ID=444444444444444444
JTC_CATEGORY_PENTA_ID=555555555555555555
JTC_CATEGORY_HEXA_ID=666666666666666666
JTC_CATEGORY_SEPTA_ID=777777777777777777
JTC_CATEGORY_OCTA_ID=888888888888888888

# ------------------------------------------
# 4. JTC Trigger Voice Channel IDs (17-20 digit snowflakes)
# ------------------------------------------
# Voice channels that members join to trigger creation of a new room
JTC_TRIGGER_SOLO_ID=100000000000000001
JTC_TRIGGER_DUO_ID=100000000000000002
JTC_TRIGGER_TRIO_ID=100000000000000003
JTC_TRIGGER_QUAD_ID=100000000000000004
JTC_TRIGGER_PENTA_ID=100000000000000005
JTC_TRIGGER_HEXA_ID=100000000000000006
JTC_TRIGGER_SEPTA_ID=100000000000000007
JTC_TRIGGER_OCTA_ID=100000000000000008

# ------------------------------------------
# 5. Logging & Diagnostics
# ------------------------------------------
# Log Level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Debug mode: true | false
DEBUG_MODE=false
